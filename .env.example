# Copy this file to .env and fill in your values.
# .env is gitignored and never committed.

# MEXC — from MEXC app → Demo Trading → API Management
MEXC_API_KEY=your_key_here
MEXC_API_SECRET=your_secret_here

# Optional: Telegram Bot API notifications (not required to run the strategy)
TELEGRAM_BOT_TOKEN=
TELEGRAM_NOTIFY_USER_ID=
